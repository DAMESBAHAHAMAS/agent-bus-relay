{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read", "Glob", "Grep", "WebSearch",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch --show-current)", "Bash(git branch --list:*)",
      "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(node --test:*)", "Bash(npm test:*)", "Bash(python3 -m pytest:*)", "Bash(ls:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gh/**)", "Read(~/.codex/**)", "Read(~/.zoho/**)",
      "Read(~/.openclaw/credentials/**)", "Read(~/.openclaw/service-env/**)", "Read(~/.openclaw/openclaw.json)",
      "Read(~/Developer/local-credentials/**)", "Read(~/Library/Keychains/**)", "Read(**/.env)", "Read(**/.env.*)",
      "Edit(~/Developer/agent-bus-relay/**)", "Write(~/Developer/agent-bus-relay/**)",
      "Edit(~/.agent-bus/claude-code/**)", "Write(~/.agent-bus/claude-code/**)",
      "Edit(~/.agent-bus/exec/.running.json)", "Write(~/.agent-bus/exec/.running.json)",
      "Edit(**/.claude/**)", "Write(**/.claude/**)", "Edit(**/CLAUDE.md)", "Write(**/CLAUDE.md)", "Edit(**/AGENTS.md)", "Write(**/AGENTS.md)",
      "Edit(**/.github/workflows/**)", "Write(**/.github/workflows/**)", "Edit(**/render.yaml)", "Write(**/render.yaml)",
      "Edit(**/.git/hooks/**)", "Write(**/.git/hooks/**)", "Edit(**/.git/config)", "Write(**/.git/config)", "Edit(**/.git)", "Write(**/.git)",
      "Bash(git * --output*)", "Bash(git *--output=*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)", "Bash(git push origin master:*)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  }
}
