{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "WelcomeIQ Coval Specialist",
    "description": "WelcomeIQ testing assistance and approved Coval evaluations."
  },
  "features": {
    "bot_user": {
      "display_name": "Coval Specialist",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "groups:read",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.groups"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
